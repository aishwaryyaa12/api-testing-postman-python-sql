{
  "info": {
    "_postman_id": "7f8b9a1c-3e2d-4c5b-a6f7-8e9d0c1b2a3f",
    "name": "E-Commerce & Orders API Test Suite",
    "description": "Enterprise API regression suite covering authentication, products catalog, cart operations, and financial calculation integrity.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health & System",
      "item": [
        {
          "name": "Check API Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response time is under 1500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/test",
              "host": ["{{baseUrl}}"],
              "path": ["test"]
            }
          }
        }
      ]
    },
    {
      "name": "Products Catalog",
      "item": [
        {
          "name": "Get All Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Products array is present and non-empty', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.products).to.be.an('array');",
                  "    pm.expect(jsonData.products.length).to.be.above(0);",
                  "});",
                  "pm.test('Each product has required fields', function () {",
                  "    var item = pm.response.json().products[0];",
                  "    pm.expect(item).to.have.property('id');",
                  "    pm.expect(item).to.have.property('title');",
                  "    pm.expect(item).to.have.property('price');",
                  "    pm.expect(item.price).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Product by ID (Valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Product ID matches request', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.eql(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1"]
            }
          }
        },
        {
          "name": "Get Product by ID (Negative - Not Found)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/999999",
              "host": ["{{baseUrl}}"],
              "path": ["products", "999999"]
            }
          }
        }
      ]
    },
    {
      "name": "Cart & Financial Calculations",
      "item": [
        {
          "name": "Verify Cart Item Subtotals vs Reported Total",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Cart totals accurately match sum of item quantities * prices', function () {",
                  "    var cart = pm.response.json();",
                  "    var calculatedTotal = 0;",
                  "    cart.products.forEach(function(item) {",
                  "        var lineTotal = item.price * item.quantity;",
                  "        calculatedTotal += lineTotal;",
                  "    });",
                  "    pm.expect(Math.round(cart.total)).to.eql(Math.round(calculatedTotal));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/carts/1",
              "host": ["{{baseUrl}}"],
              "path": ["carts", "1"]
            }
          }
        }
      ]
    }
  ]
}